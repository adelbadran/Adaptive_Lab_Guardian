# MQTT broker used by the ESP32 and the AI bridge.
ALG_MQTT_BROKER=10.35.93.69
ALG_MQTT_PORT=1883
ALG_SENSOR_TOPIC=alg1/sensors
ALG_ACTION_TOPIC=alg1/actions

# Dashboard API/SSE bridge.
ALG_DASHBOARD_PORT=8765
ALG_DASHBOARD_HISTORY=80
VITE_DASHBOARD_API_URL=http://localhost:8765

# Optional broker auth.
# ALG_MQTT_USERNAME=
# ALG_MQTT_PASSWORD=
